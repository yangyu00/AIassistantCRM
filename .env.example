# ===== 复制为 .env 后填写；.env 已在 .gitignore 中，不会提交 =====
# 优先级：系统环境变量（Docker -e 等） > .env 文件 > config.py 中的默认值

# --- 服务 ---
LOG_DIR=                       # 日志目录，留空 = 项目下 log/
APP_HOST=0.0.0.0
APP_PORT=8989
APP_RELOAD=false

# --- 接口鉴权 ---
API_URL=/api/speechQryService
API_USERS=CRM
API_TOKENS=                    # Bearer token，逗号分隔；留空 = 不校验（仅内网调试）

# --- IOP ---
IOP_TOKEN_HOST=134.80.220.55
IOP_TOKEN_PORT=80
IOP_CLIENT_ID=202408131154527921000059
IOP_CLIENT_SECRET=             # 必填，敏感信息只放这里
IOP_CUSTINFO_HOST=134.80.220.55
IOP_CUSTINFO_PORT=80
IOP_CUSTINFO_VERSION=1.0.1
IOP_CUSTINFO_TYPE=M
IOP_MAX_CONCURRENCY=20

# --- SFTP ---
SFTP_HOST=134.80.199.252
SFTP_PORT=22
SFTP_USERNAME=wangsi
SFTP_PASSWORD=                 # 必填，敏感信息只放这里
SFTP_RUNTIME_DIR=              # 业务文件/SQLite/日志根目录，留空 = 项目下 runtime/

# --- 维表与停机 ---
DIM_TABLE_CHECK_SECONDS=300
SFTP_STOP_TIMEOUT=30
